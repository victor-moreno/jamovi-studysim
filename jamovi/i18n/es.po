msgstr "{k} análisis intermedios tras {ns} participantes; límites de O'Brien-Fleming |z| ≥ {b}"

#: R/simcompare.b.R
msgid "{k} regions of {m} people"
msgstr "{k} regiones de {m} personas"

#: R/simstudy.b.R
msgid "{k} regions of {m} people (the sample size is not used): only totals, means and percentages per region are kept"
msgstr "{k} regiones de {m} personas (no se usa el tamaño muestral): solo se guardan totales, medias y porcentajes por región"

#: R/simstudy.b.R
msgid "{n} cases have fewer controls than asked"
msgstr "{n} casos tienen menos controles de los pedidos"

#: R/simstudy.b.R
msgid "{n} competing events ({label}), status 2"
msgstr "{n} eventos competitivos ({label}), estado 2"

#: R/simstudy.b.R
